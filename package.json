{
  "name": "autocut-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite",
    "dev:electron": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:python": "python -m pytest backend/tests -q",
    "lint": "eslint .",
    "check": "npm run typecheck && npm test && npm run test:python && npm run build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.14.0",
    "better-sqlite3": "^12.2.0",
    "element-plus": "^2.13.6",
    "keytar": "^7.9.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.30",
    "vue-router": "^5.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@pinia/testing": "^1.0.3",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "electron": "^41.1.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.2",
    "happy-dom": "^20.8.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.5"
  }
}
