{
  "name": "autocut-studio",
  "version": "0.7.2-license.20260814.170533",
  "description": "Windows 本地自动混剪、配音、合成与发布工作台",
  "author": "袋研官 BAG LAB",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite",
    "dev:electron": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:python": "node scripts/run-python-tests.mjs",
    "lint": "eslint .",
    "check": "npm run typecheck && npm test && npm run test:python && npm run build",
    "brand:assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-brand-assets.ps1",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "native:node": "npm rebuild better-sqlite3 keytar",
    "dist:win": "npm run native:node && npm run check && node scripts/build-installer.mjs"
    ,"license:public-config": "node scripts/write-license-public-config.mjs"
  },
  "build": {
    "appId": "com.innovessel.autocut",
    "productName": "袋研官矩阵混剪工作台",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/keytar/**/*"
    ],
    "extraResources": [
      {
        "from": "build-resources/license-public.json",
        "to": "license-public.json"
      },
      {
        "from": "build-resources/backend",
        "to": "backend"
      },
      {
        "from": "build-resources/bin",
        "to": "bin"
      },
      {
        "from": "build-resources/ms-playwright",
        "to": "ms-playwright"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "袋研官矩阵混剪工作台-${version}-${arch}.${ext}",
      "executableName": "袋研官矩阵混剪工作台"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh",
      "shortcutName": "袋研官矩阵混剪工作台",
      "uninstallDisplayName": "袋研官矩阵混剪工作台"
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.14.0",
    "better-sqlite3": "^12.2.0",
    "element-plus": "^2.13.6",
    "keytar": "^7.9.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.30",
    "vue-router": "^5.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@pinia/testing": "^1.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "electron": "^41.1.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.2",
    "happy-dom": "^20.8.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.5"
  }
}
